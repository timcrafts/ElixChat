<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Дозвіл на вихідні з'єднання (щоб качати моделі з HuggingFace) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Дозвіл на вхідні з'єднання (якщо EneyLocal піднімає локальний сервер) -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Дозвіл на читання/запис файлів, які вибрав користувач -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Дозвіл на доступ до папки завантажень (опціонально, але зручно) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
